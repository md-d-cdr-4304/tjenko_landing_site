---
import { navItems } from '../data/site';
---

<header class="bg-ivory border-b-[3px] border-black sticky top-0 z-50">
  <div class="section-container">
    <div class="flex items-center justify-between py-4 md:py-5 gap-4">

      {/* ── Wordmark ── */}
      <div class="flex items-center gap-4 shrink-0">
        <a href="/" class="flex items-baseline gap-1 group" aria-label="Tjenko home">
          <span class="font-display text-2xl md:text-3xl font-black tracking-tight text-black uppercase leading-none
                       transition-all duration-150 group-hover:text-spectrum">
            TJENKO<sup class="text-[0.45em] font-mono tracking-normal align-super ml-0.5">TM</sup>
          </span>
        </a>
        <span class="label-mono text-black/60 hidden lg:inline-block border-l-[2px] border-black/20 pl-4 leading-tight max-w-48">
          AI Networking Layer for Live Events
        </span>
      </div>

      {/* ── Desktop Nav ── */}
      <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="font-mono text-xs font-bold uppercase tracking-[0.12em] px-4 py-2
                   text-black hover:bg-black hover:text-ivory
                   border-[2px] border-transparent hover:border-black
                   transition-all duration-150"
          >
            {item.label}
          </a>
        ))}
      </nav>

      {/* ── Right: CTA + Mobile Toggle ── */}
      <div class="flex items-center gap-3 shrink-0">


        {/* ── Mobile Hamburger (details/summary, no JS) ── */}
        <details class="md:hidden relative" id="mobile-nav">
          <summary
            class="flex items-center justify-center w-11 h-11 border-[3px] border-black bg-ivory
                   cursor-pointer transition-all duration-150
                   hover:bg-black hover:text-ivory
                   list-none [&::-webkit-details-marker]:hidden"
            aria-label="Toggle navigation menu"
          >
            {/* Hamburger icon */}
            <svg width="22" height="18" viewBox="0 0 22 18" fill="none" class="stroke-current" stroke-width="2.5" stroke-linecap="square">
              <line x1="1" y1="2" x2="21" y2="2" />
              <line x1="1" y1="9" x2="21" y2="9" />
              <line x1="1" y1="16" x2="21" y2="16" />
            </svg>
          </summary>

          {/* ── Mobile Dropdown ── */}
          <nav
            class="absolute right-0 top-full mt-2 w-56 bg-ivory border-[3px] border-black shadow-brutal z-50"
            aria-label="Mobile navigation"
          >
            {navItems.map((item) => (
              <a
                href={item.href}
                class="block font-mono text-xs font-bold uppercase tracking-[0.12em] px-5 py-3.5
                       text-black hover:bg-black hover:text-ivory
                       border-b-[2px] border-black/10 last:border-b-0
                       transition-all duration-150"
              >
                {item.label}
              </a>
            ))}

          </nav>
        </details>
      </div>
    </div>
  </div>
</header>

<style>
  /* Close mobile nav when clicking a link inside it */
  details[open] > summary::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
  }
</style>
