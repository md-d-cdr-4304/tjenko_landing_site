---
/* Hero — no dynamic data needed, self-contained */
---

<section class="bg-ivory py-12 md:py-20 overflow-hidden">
  <div class="section-container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">

      {/* ── Left Column: Copy ── */}
      <div class="flex flex-col gap-6 md:gap-8 max-w-2xl">
        <span class="label-mono text-spectrum inline-flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 bg-green border-[2px] border-black"></span>
          Live · AI-Powered Networking
        </span>

        <h1 class="font-display text-5xl sm:text-6xl md:text-6xl lg:text-6xl xl:text-7xl uppercase leading-[0.92] tracking-tight text-black">
          Intelligence moves with the&nbsp;room.
        </h1>

        <p class="font-body text-lg md:text-xl text-black font-bold leading-relaxed max-w-md">
          Tjenko is the AI networking layer that understands live events and
          orchestrates meaningful connections in real&nbsp;time.
        </p>


      </div>

      {/* ── Right Column: System Panel ── */}
      <div class="flex justify-center lg:justify-end">
        <div class="panel-spectrum shadow-brutal-lg w-full max-w-md lg:max-w-lg aspect-square relative p-6 md:p-8 select-none">

          {/* ── SVG Connection Lines ── */}
          <svg
            class="absolute inset-0 w-full h-full pointer-events-none"
            viewBox="0 0 400 400"
            fill="none"
            preserveAspectRatio="xMidYMid meet"
            aria-hidden="true"
          >
            {/* Dashed connection lines between nodes through center */}
            {/* Top-left → center */}
            <line x1="90" y1="85" x2="200" y2="200" stroke="#FFF8E7" stroke-width="1.5" stroke-dasharray="6 4" opacity="0.45" />
            {/* Top-right → center */}
            <line x1="310" y1="85" x2="200" y2="200" stroke="#FFF8E7" stroke-width="1.5" stroke-dasharray="6 4" opacity="0.45" />
            {/* Bottom-left → center */}
            <line x1="90" y1="315" x2="200" y2="200" stroke="#FFF8E7" stroke-width="1.5" stroke-dasharray="6 4" opacity="0.45" />
            {/* Bottom-right → center */}
            <line x1="310" y1="315" x2="200" y2="200" stroke="#FFF8E7" stroke-width="1.5" stroke-dasharray="6 4" opacity="0.45" />
            {/* Horizontal: top-left ↔ top-right */}
            <line x1="120" y1="65" x2="280" y2="65" stroke="#91CB3E" stroke-width="1.5" stroke-dasharray="4 6" opacity="0.55" />
            {/* Horizontal: bottom-left ↔ bottom-right */}
            <line x1="120" y1="335" x2="280" y2="335" stroke="#91CB3E" stroke-width="1.5" stroke-dasharray="4 6" opacity="0.55" />
            {/* Vertical: top-left ↔ bottom-left */}
            <line x1="65" y1="110" x2="65" y2="290" stroke="#FFF8E7" stroke-width="1" stroke-dasharray="3 5" opacity="0.3" />
            {/* Vertical: top-right ↔ bottom-right */}
            <line x1="335" y1="110" x2="335" y2="290" stroke="#FFF8E7" stroke-width="1" stroke-dasharray="3 5" opacity="0.3" />
          </svg>

          {/* ── Central "T" Glyph ── */}
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none" aria-hidden="true">
            <span class="font-display text-[7rem] md:text-[9rem] font-black text-ivory/15 leading-none select-none">
              T
            </span>
          </div>

          {/* ── Status Label ── */}
          <div class="absolute top-4 left-4 md:top-6 md:left-6 flex items-center gap-2">
            <span class="inline-block w-2 h-2 bg-green border-[1.5px] border-black animate-pulse"></span>
            <span class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-ivory/80">
              Live · 4 active nodes
            </span>
          </div>

          {/* ── Node: Top-Left — ALEX ── */}
          <div class="hero-node top-[12%] left-[5%] md:top-[10%] md:left-[6%]">
            <span class="hero-node-name">Alex</span>
            <span class="hero-node-role">Marketing</span>
          </div>

          {/* ── Node: Top-Right — SAM ── */}
          <div class="hero-node top-[12%] right-[5%] md:top-[10%] md:right-[6%]">
            <span class="hero-node-name">Sam</span>
            <span class="hero-node-role">Design</span>
          </div>

          {/* ── Node: Bottom-Left — JORDAN ── */}
          <div class="hero-node bottom-[12%] left-[5%] md:bottom-[10%] md:left-[6%]">
            <span class="hero-node-name">Jordan</span>
            <span class="hero-node-role">Engineering</span>
          </div>

          {/* ── Node: Bottom-Right — TAYLOR ── */}
          <div class="hero-node bottom-[12%] right-[5%] md:bottom-[10%] md:right-[6%]">
            <span class="hero-node-name">Taylor</span>
            <span class="hero-node-role">Product</span>
          </div>

          {/* ── Green Signal Accents ── */}
          <div class="absolute top-[38%] left-[22%] w-2.5 h-2.5 bg-green border-[1.5px] border-black" aria-hidden="true"></div>
          <div class="absolute top-[30%] right-[30%] w-2 h-2 bg-green border-[1.5px] border-black" aria-hidden="true"></div>
          <div class="absolute bottom-[35%] left-[35%] w-3 h-3 bg-green border-[2px] border-black" aria-hidden="true"></div>
          <div class="absolute bottom-[28%] right-[20%] w-2 h-2 bg-green border-[1.5px] border-black" aria-hidden="true"></div>
          <div class="absolute top-[55%] right-[42%] w-1.5 h-1.5 bg-green border-[1px] border-black" aria-hidden="true"></div>
          <div class="absolute bottom-[48%] left-[18%] w-2 h-2 bg-green/70 border-[1.5px] border-black/60" aria-hidden="true"></div>

          {/* ── Bottom Score Bar ── */}
          <div class="absolute bottom-4 right-4 md:bottom-6 md:right-6 bg-black/30 px-3 py-1.5 flex items-center gap-2">
            <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-ivory/70">
              Match Score
            </span>
            <span class="font-display text-sm font-black text-green">
              94%
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-node {
    position: absolute;
    background-color: var(--color-ivory);
    border: 2.5px solid var(--color-black);
    box-shadow: 3px 3px 0px var(--color-black);
    padding: 0.5rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 1px;
    transition: all 150ms ease;
    min-width: 5rem;
  }

  .hero-node:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px var(--color-black);
  }

  .hero-node-name {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-black);
    line-height: 1.1;
    letter-spacing: 0.02em;
  }

  .hero-node-role {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-spectrum);
    line-height: 1.2;
  }
</style>
