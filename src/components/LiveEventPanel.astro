---
import { liveEvent } from '../data/site';

// Simple inline SVG icon per stat label
const statIcons: Record<string, string> = {
  Attendees: `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="7" cy="4" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
    <path d="M1 13c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.5" fill="none"/>
  </svg>`,
  Connections: `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="3" cy="7" r="2" stroke="currentColor" stroke-width="1.5" fill="none"/>
    <circle cx="11" cy="7" r="2" stroke="currentColor" stroke-width="1.5" fill="none"/>
    <line x1="5" y1="7" x2="9" y2="7" stroke="currentColor" stroke-width="1.5"/>
  </svg>`,
  Meetups: `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="1" y="2" width="12" height="10" rx="0" stroke="currentColor" stroke-width="1.5" fill="none"/>
    <line x1="1" y1="5" x2="13" y2="5" stroke="currentColor" stroke-width="1.5"/>
    <line x1="4" y1="2" x2="4" y2="0.5" stroke="currentColor" stroke-width="1.5"/>
    <line x1="10" y1="2" x2="10" y2="0.5" stroke="currentColor" stroke-width="1.5"/>
  </svg>`,
};
---

<section class="section-container py-12 md:py-16">
  <div class="border-[3px] border-black bg-ivory shadow-brutal">
    <!-- ── Top Row: Event Info + Stats ── -->
    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto]">
      <!-- Left: Event Info -->
      <div class="p-6 md:p-8">
        <div class="flex items-center gap-3 mb-4">
          <span class="label-mono text-black/60">LIVE EVENT</span>
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-green inline-block animate-pulse"></span>
            <span class="font-mono text-xs font-bold uppercase tracking-[0.15em] text-green">LIVE</span>
          </span>
        </div>

        <h2 class="font-display text-3xl md:text-4xl leading-none">
          {liveEvent.name}
        </h2>

        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-mono text-sm text-black/60">
          <span>{liveEvent.dates}</span>
          <span class="hidden md:inline">·</span>
          <span>{liveEvent.venue}</span>
        </div>
      </div>

      <!-- Right: Stats Cells -->
      <div class="flex flex-col md:flex-row border-t-[3px] md:border-t-0 md:border-l-[3px] border-black">
        {liveEvent.stats.map((stat, i) => (
          <div
            class:list={[
              'p-6 md:p-8 flex flex-col justify-center',
              i > 0 && 'border-t-[3px] md:border-t-0 md:border-l-[3px] border-black',
            ]}
          >
            <span class="font-display text-3xl md:text-4xl leading-none">
              {stat.value}
            </span>
            <span class="label-mono text-black/60 mt-2 flex items-center gap-1.5">
              <span class="inline-flex text-black/40" set:html={statIcons[stat.label] || ''} />
              {stat.label}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- ── Bottom Status Bar ── -->
    <div class="border-t-[3px] border-black px-6 md:px-8 py-3 flex items-center justify-between">
      <span class="font-mono text-xs text-black/40 uppercase tracking-wider">
        SYS:ACTIVE &nbsp;·&nbsp; TJENKO NETWORK v2.4
      </span>
      <span class="font-mono text-xs text-black/40 uppercase tracking-wider hidden md:block">
        REFRESH: REAL-TIME
      </span>
    </div>
  </div>
</section>
