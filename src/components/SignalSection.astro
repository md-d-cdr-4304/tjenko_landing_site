---
import { matchList, networkBars } from '../data/site';
---

<section id="how-it-works" class="py-12 md:py-16">
  <div class="section-container">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">

      <!-- Panel 1: AI Matches -->
      <div class="md:col-span-5 panel p-6">
        <div class="flex items-center justify-between mb-2">
          <span class="label-mono">AI Matches For You</span>
          <a href="#" class="label-mono text-spectrum hover:underline">View All ↗</a>
        </div>

        <div>
          {matchList.map((match, i) => {
            const initials = match.name
              .split(' ')
              .map((w) => w[0])
              .join('');
            return (
              <div
                class:list={[
                  'flex items-center py-4',
                  i < matchList.length - 1 && 'border-b-[2px] border-black/10',
                ]}
              >
                {/* Avatar */}
                <div class="w-10 h-10 rounded-full bg-cornflower border-[2px] border-black flex items-center justify-center shrink-0">
                  <span class="font-mono text-xs font-bold">{initials}</span>
                </div>

                {/* Info */}
                <div class="ml-3 flex-1 min-w-0">
                  <p class="font-body font-bold text-sm">{match.name}</p>
                  <p class="font-mono text-xs text-black/60 truncate">
                    {match.role} · {match.company}
                  </p>
                </div>

                {/* Score badge */}
                <div class="ml-3 shrink-0 bg-green border-[2px] border-black px-3 py-1">
                  <span class="font-mono text-xs font-bold">{match.score}% Match</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Panel 2: Network Status -->
      <div class="md:col-span-4 panel-green p-6">
        <div class="flex items-center justify-between mb-2">
          <span class="label-mono">Network Status</span>
          <a href="#" class="label-mono hover:underline">Details ↗</a>
        </div>

        <p class="font-display text-2xl mt-4">Network Active</p>
        <p class="font-body text-sm mt-2">Connections happening in real time.</p>

        {/* Bar chart */}
        <div class="flex items-end gap-1 mt-6" style="height:80px;">
          {networkBars.map((pct) => (
            <div
              class="w-3 bg-black border-[1px] border-black transition-all duration-150"
              style={`height: ${Math.round((pct / 100) * 80)}px;`}
            />
          ))}
        </div>
      </div>

      <!-- Panel 3: Secure by Design -->
      <div class="md:col-span-3 panel p-6 flex flex-col">
        <span class="label-mono">Secure By Design</span>

        {/* Lock icon */}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="48"
          height="48"
          viewBox="0 0 48 48"
          fill="none"
          class="mt-6"
        >
          <rect
            x="10"
            y="22"
            width="28"
            height="20"
            rx="0"
            stroke="var(--color-black)"
            stroke-width="3"
          />
          <path
            d="M16 22V16C16 11.5817 19.5817 8 24 8V8C28.4183 8 32 11.5817 32 16V22"
            stroke="var(--color-black)"
            stroke-width="3"
            stroke-linecap="square"
          />
          <circle cx="24" cy="33" r="3" fill="var(--color-black)" />
        </svg>

        <p class="font-display text-lg mt-4">Your data stays yours.</p>
        <p class="font-mono text-xs mt-2 text-black/60">Private. Encrypted. Always.</p>
      </div>

    </div>
  </div>
</section>
