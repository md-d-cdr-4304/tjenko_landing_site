---
import { trustCompanies } from '../data/site';

const marks: Record<string, string> = {
  Vercel: '▲',
  Linear: '◆',
  Figma: '◈',
  Ramp: '■',
  Webflow: '●',
};
---

<section class="border-y-[3px] border-black bg-ivory py-8 md:py-10">
  <div class="section-container">
    <div class="flex flex-col md:flex-row md:items-center gap-6 md:gap-10">

      {/* Label */}
      <span class="label-mono text-black/40 shrink-0">Trusted By Innovative Teams</span>

      {/* Company names */}
      <div class="flex flex-wrap items-center gap-8 md:gap-14 flex-1">
        {trustCompanies.map((company) => (
          <span class="font-display text-lg md:text-xl tracking-tight text-black/70 select-none">
            {marks[company] && (
              <span class="mr-1.5 text-black/40">{marks[company]}</span>
            )}
            {company}
          </span>
        ))}
      </div>

      {/* CTA link */}
      <a
        href="#"
        class="btn-primary px-4 py-2 text-xs shrink-0 self-start md:self-center"
      >
        Learn More ↗
      </a>

    </div>
  </div>
</section>
